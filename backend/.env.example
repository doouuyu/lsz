# 本地开发配置；复制为 .env，真实密钥不得提交。
HOST=127.0.0.1
PORT=8000
DEBUG=true

# 旧版接口配置（继续保留）
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
VL_API_KEY=

# V2 固定百炼配置（华北 2 北京）
BAILIAN_API_KEY=
BAILIAN_WORKSPACE_ID=
BAILIAN_BASE_URL=https://填workspace_id.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
BAILIAN_ASR_WS_URL=wss://填workspace_id.cn-beijing.maas.aliyuncs.com/api-ws/v1/inference/
MULTIMODAL_MODEL=qwen3.7-plus-2026-05-26
ASR_MODEL=fun-asr-realtime-2026-02-28
ASR_VOCABULARY_ID=

PREPARE_MODEL_TIMEOUT_SECONDS=180
INQUIRY_MODEL_TIMEOUT_SECONDS=120
RETRIEVAL_MODEL_TIMEOUT_SECONDS=180
FINAL_MODEL_TIMEOUT_SECONDS=600
MODEL_MAX_RETRIES=1

ATTACHMENT_MAX_COUNT=5
ATTACHMENT_MAX_BYTES=10485760
ATTACHMENT_TOTAL_MAX_BYTES=31457280
PDF_MAX_PAGES=8
PDF_RENDER_DPI=200
ATTACHMENT_IMAGE_MAX_SIDE=4096
CONSULTATION_TTL_SECONDS=1800
TEXT_LOG_RETENTION_DAYS=7
